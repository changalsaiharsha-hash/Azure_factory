{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "saiharsha-adf"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"LS_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS'"
		},
		"LS_ADLS_DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_DataLake'"
		},
		"LS_SQL_Source_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_Source'"
		},
		"LS_raw_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_raw'"
		},
		"ls_target_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_target'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "harshademosqlserver.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "harsha_sql_db"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin2026"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://harshastorage5347.dfs.core.windows.net/"
		},
		"LS_ADLS_DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://harshastorage5347.dfs.core.windows.net/"
		},
		"LS_SQL_Source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "harshademosqlserver.database.windows.net"
		},
		"LS_SQL_Source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "harsha_sql_db"
		},
		"LS_SQL_Source_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin2026"
		},
		"LS_raw_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://harshastorage5347.dfs.core.windows.net/"
		},
		"ls_target_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://harshastorage5347.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "saiharsha-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabase1_password": {
						"value": "[parameters('AzureSqlDatabase1_password')]"
					},
					"LS_ADLS_accountKey": {
						"value": "[parameters('LS_ADLS_accountKey')]"
					},
					"LS_ADLS_DataLake_accountKey": {
						"value": "[parameters('LS_ADLS_DataLake_accountKey')]"
					},
					"LS_SQL_Source_password": {
						"value": "[parameters('LS_SQL_Source_password')]"
					},
					"LS_raw_accountKey": {
						"value": "[parameters('LS_raw_accountKey')]"
					},
					"ls_target_accountKey": {
						"value": "[parameters('ls_target_accountKey')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_ADLS_DataLake_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_DataLake_properties_typeProperties_url')]"
					},
					"LS_SQL_Source_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_Source_properties_typeProperties_server')]"
					},
					"LS_SQL_Source_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_Source_properties_typeProperties_database')]"
					},
					"LS_SQL_Source_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_Source_properties_typeProperties_userName')]"
					},
					"LS_raw_properties_typeProperties_url": {
						"value": "[parameters('LS_raw_properties_typeProperties_url')]"
					},
					"ls_target_properties_typeProperties_url": {
						"value": "[parameters('ls_target_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}