								},
								{
									"name": "Set_WatermarkColumn",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_WatermarkColumn",
										"value": {
											"value": "@item().WatermarkColumn",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Copy_ToADLS",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"additionalColumns": [
												{
													"name": "SourceSchema",
													"value": {
														"value": "@variables('v_SourceSchema')",
														"type": "Expression"
													}
												},
												{
													"name": "SourceTable",
													"value": {
														"value": "@variables('v_SourceTable')",
														"type": "Expression"
													}
												}
											],
											"sqlReaderQuery": {
												"value": "SELECT * FROM [dbo].[@{variables('v_SourceTable')}]",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_SQL_Source_Dynamic",
											"type": "DatasetReference",
											"parameters": {
												"SourceSchema": "dbo",
												"SourceTable": "Customers"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_Target",
											"type": "DatasetReference",
											"parameters": {
												"TargetPath": {
													"value": "@variables('v_TargetPath')",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_SourceSchema": {
						"type": "string",
						"defaultValue": "dbo"
					},
					"p_SourceTable": {
						"type": "string",
						"defaultValue": "Customers"
					},
					"p_TargetPath": {
						"type": "string",
						"defaultValue": "/raw/customers"
					},
					"p_LoadType": {
						"type": "string",
						"defaultValue": "Full"
					}
				},
				"variables": {
					"v_SourceSchema": {
						"type": "String"
					},
					"v_SourceTable": {
						"type": "String"
					},
					"v_TargetPath": {
						"type": "String"
					},
					"v_LoadType": {
						"type": "String"
					},
					"v_WatermarkColumn": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
