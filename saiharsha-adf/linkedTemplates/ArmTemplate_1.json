							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "  SELECT SourceSchema, SourceTable, TargetPath, LoadType, WatermarkColumn \n  FROM ETL_Metadata \n  WHERE IsActive = 1",
