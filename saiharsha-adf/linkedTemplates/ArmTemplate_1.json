						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_UpdateWatermark]",
							"storedProcedureParameters": {
								"@SourceSystem": {
									"value": "MockAPI"
								},
								"@EntityName": {
									"value": "Orders"
								},
								"@NewWatermark": {
									"value": {
										"value": "@{utcnow()}",
										"type": "Expression"
									}
								},
								"@RowsExtracted": {
									"value": "100"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_SQL_Source",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"v_lastWatermark": {
						"type": "String"
					},
					"v_rowsExtracted": {
						"type": "Integer",
						"defaultValue": 0
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
