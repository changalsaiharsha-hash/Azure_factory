								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_ETLMetadata').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Set_SourceSchema",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_SourceSchema",
										"value": {
											"value": "@item().SourceSchema",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Set_SourceTable",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_SourceTable",
										"value": {
											"value": "@item().SourceTable",
											"type": "Expression"
										}
