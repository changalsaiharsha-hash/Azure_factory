{
	"name": "test_flatten",
	"properties": {
		"activities": [
			{
				"name": "FlattenOrders",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['id']"
								},
								"sink": {
									"name": "order_id",
									"type": "bigint"
								}
							},
							{
								"source": {
									"path": "$['userId']"
								},
								"sink": {
									"name": "customer_id",
									"type": "bigint"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_Raw_Orders",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SQL_Staging_Orders",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}